rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // 10 MB per file cap (matches your frontend limit)
    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // ────────────────────────────────────────────────────────────────
    // SME UNIVERSAL PROFILE
    // ────────────────────────────────────────────────────────────────

    match /universalProfile/{userId}/{allPaths=**} {
      allow read: if isSignedIn();   // funders may need to view documents
      allow write: if isOwner(userId) && isUnder10MB();
    }

    match /universalProfiles/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isUnder10MB();
    }

    // Company logos
    match /company_logos/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isUnder10MB();
    }

    // Company letterhead
    match /company_letterhead/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isUnder10MB();
    }

    // Org structure
    match /org_structure/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isUnder10MB();
    }

    // CV documents
    match /cv_documents/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isUnder10MB();
    }

    // ────────────────────────────────────────────────────────────────
    // INVESTOR UNIVERSAL PROFILE
    // ────────────────────────────────────────────────────────────────

    match /MyuniversalProfile/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isUnder10MB();
    }

    // ────────────────────────────────────────────────────────────────
    // FUNDING APPLICATIONS
    // ────────────────────────────────────────────────────────────────

    match /fundingApplications/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (
        isOwner(userId) ||
        // funders with a submission link may read
        // (server-side enforcement still applies via signed URLs)
        request.auth != null
      );
      allow write: if isOwner(userId) && isUnder10MB();
    }

    match /documents/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isUnder10MB();
    }

    // ────────────────────────────────────────────────────────────────
    // VAULT (brief §8) — owner-only
    // ────────────────────────────────────────────────────────────────

    match /vault/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isUnder10MB();
    }

    // ────────────────────────────────────────────────────────────────
    // SUBMISSION PACKAGES — owner and recipient funder
    // ────────────────────────────────────────────────────────────────

    match /submissions/{submissionId}/{allPaths=**} {
      allow read: if isSignedIn();   // finer gate on Firestore side
      allow write: if false;         // generated by Cloud Functions only
    }

    // ────────────────────────────────────────────────────────────────
    // FALLBACK — deny everything else
    // ────────────────────────────────────────────────────────────────

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}